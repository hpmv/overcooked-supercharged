<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <HeadlessDirectory Condition="'$(HeadlessDirectory)' == ''">../../artifacts/framework-prestart-check</HeadlessDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Headless"><HintPath>$(HeadlessDirectory)/Headless.dll</HintPath></Reference>
    <Reference Include="Google.Protobuf"><HintPath>$(HeadlessDirectory)/Google.Protobuf.dll</HintPath></Reference>
    <Reference Include="Thrift"><HintPath>$(HeadlessDirectory)/Thrift.dll</HintPath></Reference>
    <Reference Include="Clipper2Lib"><HintPath>$(HeadlessDirectory)/Clipper2Lib.dll</HintPath></Reference>
  </ItemGroup>
</Project>
