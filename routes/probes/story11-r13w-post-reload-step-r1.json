[
  {
    "target": "bridge",
    "request": { "command": "pause" }
  },
  {
    "target": "controller",
    "request": { "command": "actions-clear" }
  },
  {
    "target": "bridge",
    "request": { "command": "arm" }
  },
  {
    "target": "controller",
    "request": { "command": "step", "frames": 2 }
  },
  {
    "target": "controller",
    "request": { "command": "status" },
    "until": {
      "all": [
        { "path": "state", "equals": "Paused" },
        { "path": "frame", "equals": 3 },
        { "path": "requestPending", "equals": false }
      ]
    },
    "timeoutSeconds": 30
  },
  {
    "target": "bridge",
    "request": { "command": "pause" }
  },
  {
    "target": "bridge",
    "request": {
      "command": "hot-call",
      "slot": "rigidbody-actor-rebuild",
      "operation": "status",
      "args": {}
    }
  },
  {
    "target": "bridge",
    "request": {
      "command": "hot-call",
      "slot": "resume-phase",
      "operation": "status",
      "args": {}
    }
  }
]
