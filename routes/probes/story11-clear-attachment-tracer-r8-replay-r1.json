[
  {
    "target": "controller",
    "request": {"command": "status"},
    "until": {"all": [
      {"path": "state", "equals": "Paused"},
      {"path": "frame", "equals": 425},
      {"path": "requestPending", "equals": false}
    ]},
    "timeoutSeconds": 10
  },
  {"target": "bridge", "request": {"command": "pause"}},
  {"target": "bridge", "request": {"command": "hot-call", "slot": "chef-managed-mutation-tracer", "operation": "clear", "args": {}}},
  {"target": "bridge", "request": {"command": "hot-call", "slot": "chef-managed-mutation-tracer", "operation": "mark", "args": {"label": "restored-replay"}}}
]
